{
  "name": "govuk-mobile-prototype-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web components that look and behave like the GOV.UK app's own, for prototyping app journeys in HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphagov/govuk-mobile-prototype-components.git"
  },
  "files": [
    "components/*/*.html",
    "components/*/*.css",
    "components/*/*.js",
    "components/*/*.json",
    "components/*/*.ttf",
    "components/*/*.txt",
    "foundation",
    "frame",
    "component.schema.json",
    "patterns",
    "pattern.schema.json",
    "templates",
    "template.schema.json"
  ],
  "scripts": {
    "start": "eleventy --config=docs/eleventy.config.js --serve",
    "build": "eleventy --config=docs/eleventy.config.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@x-govuk/govuk-eleventy-plugin": "^9.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "markdown-it-govuk": "^0.9.0",
    "playwright": "^1.65.1"
  }
}
