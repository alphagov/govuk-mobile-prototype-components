{
  "name": "govuk-mobile-prototype-components",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web components that look and behave like the GOV.UK app's own, for prototyping app journeys in HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphagov/govuk-mobile-prototype-components.git"
  },
  "bin": {
    "govuk-app-prototype": "src/bin/govuk-app-prototype.js"
  },
  "files": [
    "src/components/*/*.html",
    "src/components/*/*.css",
    "src/components/*/*.js",
    "src/components/*/*.json",
    "src/components/*/*.ttf",
    "src/components/*/*.txt",
    "src/foundation",
    "src/frame",
    "src/patterns",
    "src/templates",
    "src/schemas",
    "src/starter",
    "src/bin",
    "catalogue"
  ],
  "scripts": {
    "start": "eleventy --config=docs/eleventy.config.js --serve",
    "build": "node scripts/catalogue.js && eleventy --config=docs/eleventy.config.js",
    "catalogue": "node scripts/catalogue.js",
    "check": "node .claude/skills/library-review/scripts/check.js --strict",
    "screenshots": "node scripts/screenshots.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@x-govuk/govuk-eleventy-plugin": "^9.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "markdown-it-govuk": "^0.9.0",
    "playwright": "^1.65.1"
  }
}
