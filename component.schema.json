{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A component's definition",
  "description": "What every components/<name>/<name>.json says about its component. See PLAN.md.",
  "type": "object",
  "required": ["name", "element", "purpose", "origin", "inputs", "outputs", "rules", "sources", "examples"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "description": "What a designer calls it.",
      "type": "string",
      "minLength": 1
    },
    "element": {
      "description": "Its custom element's tag.",
      "type": "string",
      "pattern": "^govuk-app-[a-z][a-z0-9-]*$"
    },
    "purpose": {
      "description": "What it is for, in a sentence or two.",
      "type": "string",
      "minLength": 1
    },
    "proposed": {
      "description": "Only for a component that isn't in the app today, such as one from future designs: where its design comes from. A component without it is in the app. Remove it if the component ships, and point its sources at the app.",
      "type": "object",
      "required": ["design"],
      "additionalProperties": false,
      "properties": {
        "design": {
          "description": "Where the design comes from, such as a Figma file, or a screenshot of one until there's a link.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "origin": {
      "description": "Whether it is a native component, mirroring something native to the platform, or a GOV.UK app component, the app's own.",
      "type": "object",
      "required": ["kind", "notes"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "native: a native component, which mirrors a platform control or pattern (a modal, a tab bar) and should behave as the platform's does. govuk: a GOV.UK app component, the app's own.",
          "enum": ["native", "govuk"]
        },
        "notes": {
          "description": "What it is built on, and how it differs from the platform, if at all.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "description": "What it takes from the HTML that uses it.",
      "type": "object",
      "required": ["attributes", "content"],
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "description"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["string", "boolean", "enum"] },
              "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "default": { "type": ["string", "boolean"] },
              "required": { "type": "boolean" },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "content": {
          "description": "What may be written between its tags, or null if nothing.",
          "type": ["string", "null"]
        }
      }
    },
    "outputs": {
      "description": "What it tells the page. Components send no events of their own; these are the browser's events, from the controls it draws.",
      "type": "object",
      "required": ["events"],
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rules": {
      "description": "How and when to use it, and when not to.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "description": "What it was built from.",
      "type": "object",
      "required": ["figma", "ios", "android"],
      "additionalProperties": false,
      "properties": {
        "figma": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "ios": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "android": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "other": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "references": {
      "description": "Screenshots of the app's own component, kept in the component's reference/ folder, to compare it with.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "image", "description"],
        "additionalProperties": false,
        "properties": {
          "platform": { "enum": ["ios", "android"] },
          "image": { "type": "string", "pattern": "^reference/" },
          "description": { "type": "string", "minLength": 1 },
          "from": { "type": "string" }
        }
      }
    },
    "examples": {
      "description": "Its states, as the HTML that draws them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "html"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "html": { "type": "string", "minLength": 1 },
          "frame": {
            "description": "What the docs draw it in. screen: a whole screen, phone height, with no padding of its own, for a component that lays out a screen. page: a box with room around it, the colour of a screen, for a component drawn on one, such as the search field. Otherwise a box with room around it, the colour of a modal.",
            "enum": ["screen", "page"]
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "source": {
      "type": "object",
      "required": ["repo", "path", "symbol"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "ref": { "type": "string" }
      }
    }
  }
}
